# APIキーなどの秘密情報（絶対にコミットしない）
server/.env
.env

# 学習履歴（端末ローカルの個人データ。サイズも大きいので追跡しない）
server/history.json
# 学習計画（予定・チェック・メモ。個人データ）
server/plan.json
# 想定合格率の AI 判定結果（個人データ）
server/estimate.json
# 単語カード・一問一答・理解度チェック・診断の記録（個人データ）
server/progress.json
# ワーク演習のメモ・マーカー（問題×周ごと。個人データ）
server/notes.json
server/notes.json.tmp
# 配点予想（server/haiten.json）は消えないよう Git 管理する（.gitignore しない）

# 解答記録（採点のたびに自動生成される個人の解答・採点。README だけ追跡）
解答記録/*
!解答記録/README.md

# OS / エディタ
.DS_Store
._*
Thumbs.db
*.code-workspace
.claude/settings.local.json
node_modules/

# IPA過去問に由来するコンテンツは再配布しない（ローカル専用・push対象外）
#   - 実問題ページ画像 / 図（PDFから描画した画像）
#   - 問題データ（本文・公式解答例の文字起こし）とそのページ一覧
apps/work/pages/
apps/work/figs/
apps/work/_pages.js
apps/work/r*_pm*_q*.js
tmp/*

# ローカル専用リポジトリ（学習記録と過去問データ。絶対に公開しない）
.git-local/

参考資料/*
# Anki 用の書き出しファイル（apps/tools/anki-export.js でいつでも作り直せる）
flashcards/*.apkg
